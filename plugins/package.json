{
  "name": "buzz-plugins",
  "private": true,
  "type": "module",
  "description": "Buzz's own plugins that run as programs, and the SDK they share.",
  "workspaces": [
    "sdk",
    "bestie",
    "diffs",
    "todos",
    "channel-usage",
    "feedback",
    "reminders",
    "github"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
